{
  "name": "@vitejs/plugin-islands",
  "version": "0.0.0",
  "private": true,
  "description": "Islands / partial-hydration bundle generator for Vite, derived from the \"use client\" boundary logic of @vitejs/plugin-rsc.",
  "keywords": [
    "hydration",
    "islands",
    "react",
    "vite",
    "vite-plugin"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "types"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./types": "./types/index.d.ts",
    ".": "./dist/index.js",
    "./runtime/server": "./dist/runtime/server.js",
    "./runtime/client": "./dist/runtime/client.js"
  },
  "scripts": {
    "test": "vitest",
    "tsc": "tsc -p tsconfig.json",
    "dev": "tsdown --watch src",
    "build": "tsdown"
  },
  "dependencies": {
    "@vitejs/plugin-rsc": "workspace:*",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.4",
    "vite": "^8.3.7"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.0.0"
  }
}
